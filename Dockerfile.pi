# Sandbox image for running Pi against Chinese-hosted models via OpenCode.
# The repository is bind-mounted at /workspace by bin/pi, never copied in, so
# this image stays valid across commits and holds no project state.
FROM node@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        fd-find \
        git \
        less \
        procps \
        python3 \
        python3-venv \
        ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_VERSION=0.12.17 UV_INSTALL_DIR=/usr/local/bin sh \
    && npm install --global --ignore-scripts \
        @earendil-works/pi-coding-agent@0.86.1 \
    && npm cache clean --force

# Herdr, so the agent can run a fleet of Pi children inside the sandbox. The
# binary comes from the release that herdr.dev/latest.json pins, against the
# SHA-256 that manifest carried on 2026-09-21, for the same reason the npm
# install above is pinned: a rebuild must not pull unreviewed code into a
# container holding an API key. Take both digests from the manifest when
# bumping the version.
RUN set -eu; \
    version=0.9.1; \
    case "$(dpkg --print-architecture)" in \
        amd64) target=linux-x86_64; \
            sha=2a02fed16beb651ef006e1d43f048f652ca4dc58ad053cd2d44450563d5c54b7 ;; \
        arm64) target=linux-aarch64; \
            sha=f4ccf4de745f2cb9a39a983e9ba3703dad50ec2a58dea83026ceab721bbd8d9e ;; \
        *) printf 'no herdr release for %s\n' "$(dpkg --print-architecture)" >&2; \
            exit 1 ;; \
    esac; \
    curl -LsSf -o /usr/local/bin/herdr \
        "https://github.com/herdrdev/herdr/releases/download/v$version/herdr-$target"; \
    printf '%s  %s\n' "$sha" /usr/local/bin/herdr | sha256sum --check --quiet; \
    chmod 0755 /usr/local/bin/herdr

# Start the container's own Herdr server before Pi: Herdr's API commands do not
# start one, and the socket it listens on lives in the agent's home, so a fleet
# started here reaches nothing outside the container. Pi replaces the script
# rather than running under it, so the container's foreground process stays Pi.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    '# The herdr skill refuses to act unless this is set.' \
    'export HERDR_ENV=1' \
    'herdr server >/dev/null 2>&1 &' \
    'exec pi "$@"' \
    > /usr/local/bin/pi-sandbox-entrypoint \
    && chmod 0755 /usr/local/bin/pi-sandbox-entrypoint

# The bind-mounted checkout is owned by the host user, so Git needs /workspace
# declared safe. Commits get a sandbox identity rather than the host's, which
# keeps host Git configuration and credentials out of the container.
RUN git config --system --add safe.directory /workspace \
    && git config --system user.name 'Pi Sandbox' \
    && git config --system user.email 'pi-sandbox@localhost'

# Own the home directory in the image layer so the first run of the named state
# volume inherits that ownership instead of coming back root-owned.
RUN useradd --create-home --shell /bin/bash agent
ENV HOME=/home/agent

# Keep uv's virtualenv out of /workspace: the host checkout carries a macOS
# .venv that a Linux `uv sync` would otherwise overwrite.
ENV UV_PROJECT_ENVIRONMENT=/home/agent/workspace-venv \
    UV_CACHE_DIR=/home/agent/uv-cache

# Put the state volume's bin directories on PATH so tools the agent installs
# into its home (rustup, cargo install, uv tool install, pip --user) are still
# found on the next run instead of being reinstalled. Appended rather than
# prepended, so nothing in the volume can shadow a system binary.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/agent/.local/bin:/home/agent/.cargo/bin

USER agent

# Extensions. Installed as `agent`, so the files land in /home/agent owned by
# the user that will read them.
# Pinned and with lifecycle scripts off, like the npm install above: a rebuild
# must not pull unreviewed third-party code into a sandbox holding an API key.
# `pi install` has no --ignore-scripts flag, so npm reads it from the
# environment, exported rather than ENV to leave the agent's own npm alone.
RUN export npm_config_ignore_scripts=true \
    && pi install npm:pi-subagents@0.70.0 \
    && pi install npm:@tintinweb/pi-subagents@0.19.0 \
    && pi install npm:pi-background-tasks@2.5.0 \
    && pi install npm:pi-extension-manager@0.8.2 \
    && npm cache clean --force

# Herdr's own agent skill, printed by the pinned binary so it describes the
# version installed rather than a copy that drifts from it. It covers the CLI:
# IDs, agent states, and how to read a JSON response. The skill beside it
# covers what is different about this sandbox.
RUN mkdir -p /home/agent/.pi/agent/skills/herdr \
    && herdr --skill > /home/agent/.pi/agent/skills/herdr/SKILL.md

# What the fleet is, in Pi's global skills directory: a model that cannot see
# the topology will not invent it. Written as `agent`, beside the extensions,
# so it seeds the same state volume they do.
RUN mkdir -p /home/agent/.pi/agent/skills/herdr-fleet \
    && printf '%s\n' \
    '---' \
    'name: herdr-fleet' \
    'description: Start and steer other Pi agents as children of this session,' \
    '  through the Herdr server running in this sandbox. Use when work splits' \
    '  into parts worth running at the same time, or when a second agent should' \
    '  review what this one did.' \
    '---' \
    '' \
    '# Fleet' \
    '' \
    'This container runs its own Herdr server. It manages panes in this' \
    'container only and reaches nothing on the host, so there is no other' \
    'session to inspect and no human watching the panes.' \
    '' \
    'Read the `herdr` skill for the CLI itself. Two things there do not hold' \
    'here: this session runs as the foreground process of the container' \
    'rather than in a pane, so `--current` and `$HERDR_PANE_ID` are not' \
    'available and there is no calling pane to split, and there are no saved' \
    'machines, so `--machine` and `--remote` have nothing to reach. Start from' \
    'a workspace.' \
    '' \
    'To put a child to work:' \
    '' \
    '1. `herdr workspace create --cwd /workspace --label <name> --no-focus`,' \
    '   and take `.result.root_pane.pane_id` from the JSON it prints.' \
    '2. `herdr agent start <name> --kind pi --pane <pane-id> -- --provider' \
    '   opencode --model deepseek-v4.1-flash`. Both flags are required: a bare' \
    '   `pi` in a pane here has no provider configured and will fail.' \
    '3. `herdr agent prompt <name> <text> --wait` to send it work.' \
    '4. `herdr pane read <pane-id>` to read what it did.' \
    '5. `herdr pane close <pane-id>` when it is finished.' \
    '' \
    'A child is a full Pi session, not a subagent: it has its own context and' \
    'keeps working while this session does something else. It also shares this' \
    'container, meaning the same `/workspace` checkout, the same API key, the' \
    'same process limit, and the same fate when the container exits. Two or' \
    'three at a time is plenty. Close what you finish with, and tell the user' \
    'what the fleet did, since they cannot see these panes.' \
    > /home/agent/.pi/agent/skills/herdr-fleet/SKILL.md

WORKDIR /workspace
ENTRYPOINT ["pi-sandbox-entrypoint"]
