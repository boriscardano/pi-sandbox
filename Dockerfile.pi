# Sandbox image for running Pi against Chinese-hosted models via OpenCode.
# The repository is bind-mounted at /workspace by the pi wrapper at the
# repository root, never copied in, so this image stays valid across commits
# and holds no project state.
# The tag names the version and the digest pins the build to the index it was
# reviewed at. Bump both together, re-reading the digest from the registry.
FROM node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

# The wrapper tags each build by the contents of its inputs. This label marks
# the images built from this Dockerfile, so a dangling one left by a same-tag
# rebuild is what `docker image prune --filter label=pi-sandbox.image=1`
# removes.
LABEL pi-sandbox.image=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        fd-find \
        git \
        less \
        procps \
        python3 \
        python3-venv \
        ripgrep \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# uv, for the Python tooling the agent runs, from uv's official distroless
# image, which is what uv's Docker docs recommend. Pinned by the digest
# ghcr.io/astral-sh/uv reported for the multi-arch index of tag 0.13.5 on
# 2026-10-22: a rebuild must not pull unreviewed code into a container holding
# an API key. Bump the version and digest together, re-reading the digest from
# the registry.
COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff \
    /uv /uvx /usr/local/bin/

# Python 3.14 for projects that need more than Debian's 3.11, root-owned
# outside the agent's home. Its bin directory comes after /usr/bin on PATH, so
# python3 stays Debian's, and uv keeps choosing 3.11 for a project that accepts
# it, as it did before, and finds 3.14 without a download for one that needs
# 3.12 or newer. 3.14 rather than 3.15 because compiled packages still lack
# 3.15 wheels and there is no compiler here. A project that pins another
# version makes uv download that one into its state volume, about 90 MB. The
# build downloads the interpreter from python-build-standalone on GitHub, and
# the uv pinned above names the exact build and checks it against the sha256 it
# carries, so Python's own fixes arrive by bumping uv.
RUN UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_PYTHON_BIN_DIR=/opt/uv-python/bin \
        UV_CACHE_DIR=/tmp/uv-build-cache \
        uv python install 3.14.9 \
    && rm -rf /tmp/uv-build-cache \
    && /opt/uv-python/bin/python3.14 -I -c ''

# The entrypoint, which writes the subscription key Pi expects in auth.json
# before becoming Pi. Copied in while still root, since /usr/local/bin is not
# writable by the agent.
COPY --chmod=0755 entrypoint.sh /usr/local/bin/pi-sandbox-entrypoint

# The bind-mounted checkout is owned by the host user, so Git needs /workspace
# declared safe. Commits get a sandbox identity rather than the host's, which
# keeps host Git configuration and credentials out of the container.
RUN git config --system --add safe.directory /workspace \
    && git config --system user.name 'Pi Sandbox' \
    && git config --system user.email 'pi-sandbox@localhost'

# The base image carries a node user and group at 1000:1000, the common Linux
# host uid and gid. Remove them so agent can take those ids rather than have a
# second user sharing them.
RUN userdel --remove node 2>/dev/null || true; \
    groupdel node 2>/dev/null || true

# On Linux the wrapper builds with the host uid and gid, because a bind mount
# keeps the host ownership. The defaults leave Docker Desktop images, and the
# state volumes they already own as 1001, unchanged.
ARG AGENT_UID=1001
ARG AGENT_GID=1001

# Own the home directory in the image layer so the first run of the named state
# volume inherits that ownership instead of coming back root-owned. The group is
# always named agent so `useradd --gid agent` resolves for any gid. --non-unique
# lets it take a gid that already exists in the image (gid 100 is users) without
# refusing to build.
RUN groupadd --non-unique --gid "$AGENT_GID" agent \
    && useradd --create-home --shell /bin/bash --uid "$AGENT_UID" \
        --gid agent agent
ENV HOME=/home/agent

# Keep uv's virtualenv out of /workspace: the host checkout carries a macOS
# .venv that a Linux `uv sync` would otherwise overwrite. uv's cache goes with
# the container rather than filling every project's volume, and is copied
# from, since a hard link cannot cross from /tmp into the volume.
ENV UV_PROJECT_ENVIRONMENT=/home/agent/workspace-venv \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_LINK_MODE=copy

# Put the state volume's bin directories on PATH so tools the agent installs
# into its home (rustup, cargo install, uv tool install, pip --user) are still
# found on the next run instead of being reinstalled. Appended rather than
# prepended, so nothing in the volume can shadow a system binary. The
# image's Python 3.14 stays after /usr/bin, as the step installing it explains.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/uv-python/bin:/home/agent/.local/bin:/home/agent/.cargo/bin

# Extensions. The entrypoint installs the four into the state volume, which is
# also what reaches a project whose volume already exists, so that is the one
# place to change the set. Nothing is seeded here.

WORKDIR /workspace

# Pi goes in last, after every other layer that builds a file, so a new release
# rebuilds only this one, and its build cache is a record no later layer builds
# on, which the wrapper can prune once the image that used it is gone. The
# wrapper passes the Pi version it looked up, and there is no default, so
# a build without one fails here at once rather than installing an empty
# version. docs/design.md explains why the newest release runs rather than a
# reviewed pin.
ARG PI_VERSION
RUN : "${PI_VERSION:?the wrapper must pass --build-arg PI_VERSION}" \
    && npm install --global --ignore-scripts \
        @earendil-works/pi-coding-agent@$PI_VERSION \
    && npm cache clean --force \
    && rm -rf "$HOME/.npm"

# The label holds the version the wrapper compares against the one it looked
# up, so a newer Pi rebuilds the image. `pi-sandbox.image=1` above stays the
# marker `docker image prune` filters on.
LABEL pi-sandbox.version="$PI_VERSION"

# npm caches in the container's /tmp, which goes with it, for every npm call at
# run time, including a `pi install` the user runs, so releases do not pile up
# in the volume. The install above runs as root with HOME already set, and the
# root-owned ~/.npm it left used to be copied into every new volume, where the
# agent could not write it and such an install failed with EACCES. It is
# removed now, but older volumes still hold it. Set after that install, so its
# cache stays out of /tmp.
ENV npm_config_cache=/tmp/npm-cache

USER agent

ENTRYPOINT ["pi-sandbox-entrypoint"]
