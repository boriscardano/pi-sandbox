# Sandbox image for running Pi against Chinese-hosted models via OpenCode.
# The repository is bind-mounted at /workspace by the pi wrapper at the
# repository root, never copied in, so this image stays valid across commits
# and holds no project state.
# The tag carries the version Dependabot compares, and the digest pins the
# build to the index it was reviewed at, so the two move together.
FROM node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

# The wrapper tags each build by the contents of its inputs. This label marks
# the images built from this Dockerfile, so a dangling one left by a same-tag
# rebuild is what `docker image prune --filter label=pi-sandbox.image=1`
# removes.
LABEL pi-sandbox.image=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        fd-find \
        git \
        less \
        procps \
        python3 \
        python3-venv \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Pi's version is a build argument so the wrapper can rebuild this image when
# npm publishes a newer release. The owner chose to always run the newest Pi
# rather than a reviewed pin, which means an upstream release reaches this
# sandbox, and the API key it holds, without review. The wrapper passes the
# version it found and compares the image's label to decide whether to rebuild.
# There is no default: the wrapper only builds after it looked a version up, so
# a build without one fails here at once rather than installing an empty
# version.
ARG PI_VERSION
RUN : "${PI_VERSION:?the wrapper must pass --build-arg PI_VERSION}" \
    && npm install --global --ignore-scripts \
        @earendil-works/pi-coding-agent@$PI_VERSION \
    && npm cache clean --force

# uv, for the Python tooling the agent runs, from uv's official distroless
# image, which is what uv's Docker docs recommend. Pinned by the digest
# ghcr.io/astral-sh/uv reported for the multi-arch index of tag 0.12.17 on
# 2026-09-21: a rebuild must not pull unreviewed code into a container holding
# an API key. Bump the version and digest together, re-reading the digest from
# the registry.
COPY --from=ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc \
    /uv /uvx /usr/local/bin/

# Herdr, so the agent can run a fleet of Pi children inside the sandbox. The
# binary and its SHA-256 both come from herdr.dev/latest.json at build time.
# The owner chose to always run the newest Herdr rather than a reviewed pin, so
# the digest comes from the same publisher as the binary: it protects against a
# corrupted or swapped download, not against a bad release. The asset URL has
# to be the GitHub release for that version, so a manifest that points
# elsewhere fails the build. The wrapper passes HERDR_VERSION and compares the
# image's label to decide whether to rebuild. There is no default: the manifest
# only carries a digest for the release it names, so a default naming an older
# release fails the check below as soon as Herdr moves on. A build without one
# fails on the guard here rather than in the manifest comparison.
ARG HERDR_VERSION
RUN set -eu; \
    : "${HERDR_VERSION:?the wrapper must pass --build-arg HERDR_VERSION}"; \
    case "$(dpkg --print-architecture)" in \
        amd64) target=linux-x86_64 ;; \
        arm64) target=linux-aarch64 ;; \
        *) printf 'no herdr release for %s\n' "$(dpkg --print-architecture)" >&2; \
            exit 1 ;; \
    esac; \
    curl -LsSf -o /tmp/herdr-latest.json https://herdr.dev/latest.json; \
    python3 -c 'import json,sys; m=json.load(open("/tmp/herdr-latest.json")); t,w=sys.argv[1:3]; assert m.get("version")==w, "herdr manifest is "+str(m.get("version"))+ ", not "+w; print(m["assets"][t]); print(m["sha256"][t])' "$target" "$HERDR_VERSION" > /tmp/herdr-release; \
    url=$(sed -n 1p /tmp/herdr-release); \
    case "$url" in \
        "https://github.com/herdrdev/herdr/releases/download/v$HERDR_VERSION/"*) ;; \
        *) printf 'herdr asset URL is not the expected release: %s\n' "$url" >&2; \
            exit 1 ;; \
    esac; \
    curl -LsSf -o /usr/local/bin/herdr "$url"; \
    printf '%s  %s\n' "$(sed -n 2p /tmp/herdr-release)" /usr/local/bin/herdr \
        | sha256sum --check --quiet; \
    chmod 0755 /usr/local/bin/herdr

# One label holds both versions the wrapper compares, so a rebuild of either
# tool is detected without a second inspect. `pi-sandbox.image=1` above stays
# the marker `docker image prune` filters on.
LABEL pi-sandbox.versions="pi=$PI_VERSION herdr=$HERDR_VERSION"

# The entrypoint, which starts this container's own Herdr server and writes the
# subscription key Pi expects in auth.json before becoming Pi. Copied in while
# still root, since /usr/local/bin is not writable by the agent.
COPY --chmod=0755 entrypoint.sh /usr/local/bin/pi-sandbox-entrypoint

# The bind-mounted checkout is owned by the host user, so Git needs /workspace
# declared safe. Commits get a sandbox identity rather than the host's, which
# keeps host Git configuration and credentials out of the container.
RUN git config --system --add safe.directory /workspace \
    && git config --system user.name 'Pi Sandbox' \
    && git config --system user.email 'pi-sandbox@localhost'

# The base image carries a node user and group at 1000:1000, the common Linux
# host uid and gid. Remove them so agent can take those ids rather than have a
# second user sharing them.
RUN userdel --remove node 2>/dev/null || true; \
    groupdel node 2>/dev/null || true

# On Linux the wrapper builds with the host uid and gid, because a bind mount
# keeps the host ownership. The defaults leave Docker Desktop images, and the
# state volumes they already own as 1001, unchanged.
ARG AGENT_UID=1001
ARG AGENT_GID=1001

# Own the home directory in the image layer so the first run of the named state
# volume inherits that ownership instead of coming back root-owned. The group is
# always named agent so `useradd --gid agent` resolves for any gid. --non-unique
# lets it take a gid that already exists in the image (gid 100 is users) without
# refusing to build.
RUN groupadd --non-unique --gid "$AGENT_GID" agent \
    && useradd --create-home --shell /bin/bash --uid "$AGENT_UID" \
        --gid agent agent
ENV HOME=/home/agent

# Keep uv's virtualenv out of /workspace: the host checkout carries a macOS
# .venv that a Linux `uv sync` would otherwise overwrite.
ENV UV_PROJECT_ENVIRONMENT=/home/agent/workspace-venv \
    UV_CACHE_DIR=/home/agent/uv-cache

# Put the state volume's bin directories on PATH so tools the agent installs
# into its home (rustup, cargo install, uv tool install, pip --user) are still
# found on the next run instead of being reinstalled. Appended rather than
# prepended, so nothing in the volume can shadow a system binary.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/agent/.local/bin:/home/agent/.cargo/bin

USER agent

# Extensions. The entrypoint installs the four into the state volume on every
# start, which is also what reaches a project whose volume already exists, so
# that is the one place to change the set. Nothing is seeded here.

# What the fleet is, since a model that cannot see the topology will not invent
# it. The entrypoint copies this into the volume's skill directory on every
# start, so it stays root-owned and out of the agent's reach.
COPY herdr-fleet.md /usr/local/share/pi-sandbox/herdr-fleet.md

WORKDIR /workspace
ENTRYPOINT ["pi-sandbox-entrypoint"]
