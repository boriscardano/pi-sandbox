# Sandbox image for running Pi against Chinese-hosted models via OpenCode.
# The repository is bind-mounted at /workspace by bin/pi, never copied in, so
# this image stays valid across commits and holds no project state.
FROM node@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        fd-find \
        git \
        less \
        procps \
        python3 \
        python3-venv \
        ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_VERSION=0.12.17 UV_INSTALL_DIR=/usr/local/bin sh \
    && npm install --global --ignore-scripts \
        @earendil-works/pi-coding-agent@0.86.0 \
    && npm cache clean --force

# The bind-mounted checkout is owned by the host user, so Git needs /workspace
# declared safe. Commits get a sandbox identity rather than the host's, which
# keeps host Git configuration and credentials out of the container.
RUN git config --system --add safe.directory /workspace \
    && git config --system user.name 'Pi Sandbox' \
    && git config --system user.email 'pi-sandbox@localhost'

# Own the home directory in the image layer so the first run of the named state
# volume inherits that ownership instead of coming back root-owned.
RUN useradd --create-home --shell /bin/bash agent
ENV HOME=/home/agent

# Keep uv's virtualenv out of /workspace: the host checkout carries a macOS
# .venv that a Linux `uv sync` would otherwise overwrite.
ENV UV_PROJECT_ENVIRONMENT=/home/agent/workspace-venv \
    UV_CACHE_DIR=/home/agent/uv-cache

# Put the state volume's bin directories on PATH so tools the agent installs
# into its home (rustup, cargo install, uv tool install, pip --user) are still
# found on the next run instead of being reinstalled. Appended rather than
# prepended, so nothing in the volume can shadow a system binary.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/agent/.local/bin:/home/agent/.cargo/bin

USER agent

# Extensions. Installed as `agent`, so the files land in /home/agent owned by
# the user that will read them.
# Pinned and with lifecycle scripts off, like the npm install above: a rebuild
# must not pull unreviewed third-party code into a sandbox holding an API key.
# `pi install` has no --ignore-scripts flag, so npm reads it from the
# environment, exported rather than ENV to leave the agent's own npm alone.
RUN export npm_config_ignore_scripts=true \
    && pi install npm:pi-subagents@0.70.0 \
    && pi install npm:@tintinweb/pi-subagents@0.19.0 \
    && pi install npm:pi-background-tasks@2.5.0 \
    && pi install npm:pi-extension-manager@0.8.2 \
    && npm cache clean --force

WORKDIR /workspace
ENTRYPOINT ["pi"]
