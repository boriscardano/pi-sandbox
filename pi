#!/bin/sh
# Run Pi in a Docker sandbox against whatever repository you are standing in.
#
#   cd ~/any/project && /path/to/pi-sandbox/pi
#
# Only that repository is mounted (at /workspace). The container gets no host
# home directory, no SSH or cloud credentials, no Docker socket and no Herdr
# socket, so nothing in it can reach your host's Docker daemon or agents. The
# host secrets it receives are OPENCODE_GO_API_KEY, which the default model
# needs, and OPENCODE_API_KEY if you have one, both forwarded by name so their
# values never land in the command line or an image layer. That first key is
# required only for the default: naming another provider with --provider or a
# provider/model string runs without it, and that provider's own key then comes
# through OPENCODE_API_KEY or PI_SANDBOX_ENV.
#
#   export OPENCODE_GO_API_KEY=$(pi auth print-api-key --provider opencode-go)
# Forward further host variables by naming them in PI_SANDBOX_ENV, for example
# PI_SANDBOX_ENV='TYPESAFE_API_KEY OTHER_TOKEN'. Every variable you add is
# readable by whatever runs in the container, so add only what it needs.
#
# The script is named `pi` on purpose: Herdr identifies a pane's agent from the
# launched program's name, so this shows up as a real Pi agent in Herdr.
# shellcheck disable=SC1007  # `CDPATH= cd` is a deliberate prefix assignment
set -eu

# Read the whole body before running any of it. sh reads a script as it goes,
# and this wrapper stays alive for the whole session, so an edit or `git pull`
# that replaces this file mid-session would otherwise leave the shell reading
# the new file at the old byte offset and running whatever text is there. A
# brace group is parsed in full before its first command runs. The closing
# brace is never reached: the exit above it leaves the group.
{
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
dockerfile=$script_dir/Dockerfile.pi

# shasum first, sha1sum as the fallback where shasum is absent. Keep this
# order: changing the digest would rename every existing volume and orphan the
# state in it, and would change the image tag for no reason.
if command -v shasum >/dev/null 2>&1; then
    hash_cmd=shasum
elif command -v sha1sum >/dev/null 2>&1; then
    hash_cmd=sha1sum
else
    printf '%s\n' "need shasum or sha1sum to name the image and state volume" >&2
    exit 2
fi

# On Linux the bind mount keeps the host uid and gid, so build the image with
# them and append them to the tag input: two host users, or a changed uid, get
# their own image. Docker Desktop maps the mounted files to the container user,
# so there the defaults keep the images and volumes that already exist. Running
# as root would make the container user uid 0 and leave root-owned files in the
# project, so refuse it.
build_args=''
host_ids=''
if [ "$(uname -s)" = Linux ]; then
    if [ "$(id -u)" -eq 0 ]; then
        printf '%s\n' "refusing to run as root: the container user would be uid 0 and the project's files would end up root-owned" >&2
        exit 2
    fi
    host_ids=$(id -u):$(id -g)
    build_args="--build-arg AGENT_UID=$(id -u) --build-arg AGENT_GID=$(id -g)"
fi

# Tag the image by the contents of the files that build it, so a `git pull`
# that changes one produces a tag that does not exist yet and the build below
# rebuilds it instead of silently running the old image. The files are hashed
# in this fixed order, and the Linux host ids are appended to the same list.
image_tag=$(
    {
        cat "$dockerfile" \
            "$script_dir/entrypoint.sh"
        printf '%s' "$host_ids"
    } \
        | "$hash_cmd" \
        | cut -c1-12
)
image=pi-sandbox:$image_tag

# The repository to mount: the nearest directory at or above the launch
# directory that holds a `.git`, either the directory itself or the file a
# linked worktree or submodule checkout uses, else the launch directory. This
# is what makes the script work for any project instead of one checkout.
#
# Git is deliberately not asked. `git rev-parse --show-toplevel` honours
# `core.worktree` in .git/config and the `gitdir` in a `.git` file, and both
# live in the project, so the container can write them. A value the agent left
# there made git name any host directory and the wrapper mounted it: with
# `core.worktree = /etc` the next launch bind-mounted the host's /etc at
# /workspace, and a path under the home directory would have exposed it the
# same way. The nearest `.git` cannot be moved by a config value.
launch_dir=$(pwd)
project=$launch_dir
while [ "$project" != / ] && [ ! -e "$project/.git" ]; do
    project=$(dirname -- "$project")
done
if [ ! -e "$project/.git" ]; then
    project=$launch_dir
    printf '%s\n' "pi-sandbox: warning: no .git at or above $launch_dir, so that directory itself is mounted" >&2
fi
project=$(CDPATH= cd -- "$project" && pwd)

# Refuse the mounts that would defeat the point: the whole disk, or a home
# directory carrying ~/.ssh, ~/.aws and every other project. Compare physical
# paths, so a symlink or another case of the name cannot hide them, with
# `env pwd -P`: bash, /bin/sh on macOS, keeps the case in its builtin.
# `project` keeps the launch spelling, which names the state volume, and the
# physical path names the container, so a session is found under any spelling.
physical=$(CDPATH= cd -- "$project" && env pwd -P)
home=${HOME%/}
if [ -d "$home" ]; then
    home=$(CDPATH= cd -- "$home" && env pwd -P)
fi
case "$physical" in
    /) printf '%s\n' "refusing to mount the whole filesystem" >&2; exit 2 ;;
esac
case "$home/" in
    "$physical"/*)
        printf '%s\n' "refusing to mount $project: it contains your home directory" >&2
        exit 2
        ;;
esac

# This script runs on the host for every project, and Dockerfile.pi and
# entrypoint.sh build the image every project runs in. Mounting the directory
# that holds them would let the agent rewrite what the host runs at the next
# launch anywhere.
case "$(CDPATH= cd -- "$script_dir" && env pwd -P)/" in
    "$physical"/*)
        printf '%s\n' "refusing to mount $project: it contains this wrapper ($script_dir), which the agent could rewrite to run on your host at the next launch. Run a copy of the wrapper from outside the project" >&2
        exit 2
        ;;
esac

# Docker parses --mount as comma-separated fields, so a comma anywhere in the
# project path would split the source and mount something else.
case "$project" in
    *,*)
        printf '%s\n' "refusing to mount $project: the path contains a comma" >&2
        exit 2
        ;;
esac

# Extra host variables to forward, by name only. Names are validated so a
# stray value cannot smuggle in another docker flag. The command substitution
# is word-split and would also be pathname-expanded, so `set -f` stops a value
# like `*` from being replaced by the project's filenames: without it, a glob
# could forward a variable the caller never named, which the README says
# cannot happen.
extra_env=''
set -f
for name in $(printf '%s' "${PI_SANDBOX_ENV:-}" | tr ',' ' '); do
    case "$name" in
        [A-Za-z_]*) ;;
        *) printf '%s\n' "PI_SANDBOX_ENV: invalid variable name: $name" >&2; exit 2 ;;
    esac
    if [ -n "$(printf '%s' "$name" | tr -d 'A-Za-z0-9_')" ]; then
        printf '%s\n' "PI_SANDBOX_ENV: invalid variable name: $name" >&2
        exit 2
    fi
    extra_env="$extra_env --env $name"
done
set +f

# One state volume per project, so sessions and `pi --resume` stay separate.
# Inside the container every project is /workspace, which would otherwise make
# them share one session history.
project_tag=$(printf '%s' "$project" | "$hash_cmd" | cut -c1-8)
state_volume=pi-sandbox-$(basename "$project" | tr -c 'A-Za-z0-9_.-' '-')-$project_tag

# Default to a Chinese-hosted model through OpenCode, unless the caller picks
# one. `deepseek-v4.1-flash` is on the opencode-go subscription and not on
# OpenCode Zen, which is why the provider is named alongside it.
# Pi's subcommands are recognised only as the first argument, so prepending the
# default to `pi install npm:...` would send it to the model as a chat message
# instead of installing anything. Leave those alone.
# Keep this list in step with the same list in entrypoint.sh.
case "${1:-}" in
    install | remove | uninstall | update | list | config | auth) ;;
    *)
        # One argument at a time. Matching the flattened "$*" would read a
        # prompt that mentions the flag as picking a model.
        #
        # The two are tracked apart because `--model kimi-k3` on its own is
        # ambiguous across the providers Pi knows and it refuses to run, so the
        # provider is still supplied. A `provider/model` string picks its own
        # provider, and adding the flag as well would override it and send the
        # rest of the name to the wrong API.
        chose_model=''
        chose_provider=''
        needs_key=''
        wants_info=''
        model_next=''
        provider_next=''
        for arg in "$@"; do
            if [ -n "$model_next" ]; then
                model_next=''
                # A `provider/model` string names its own provider, and one
                # under opencode-go needs the key without the flag too.
                case "$arg" in
                    opencode-go/*) chose_provider=1; needs_key=1 ;;
                    */*) chose_provider=1 ;;
                esac
                continue
            fi
            if [ -n "$provider_next" ]; then
                provider_next=''
                case "$arg" in opencode-go) needs_key=1 ;; esac
                continue
            fi
            case "$arg" in
                --) break ;;  # everything after this is a message, not a flag
                # Pi prints these and exits without a model call.
                --help | -h | --version | -v) wants_info=1 ;;
                --model) chose_model=1; model_next=1 ;;
                --model=opencode-go/*) chose_model=1; chose_provider=1; needs_key=1 ;;
                --model=*/*) chose_model=1; chose_provider=1 ;;
                --model=*) chose_model=1 ;;
                --provider) chose_provider=1; provider_next=1 ;;
                --provider=opencode-go) chose_provider=1; needs_key=1 ;;
                --provider=*) chose_provider=1 ;;
            esac
        done
        # Both are supplied, because naming one and leaving the other to Pi
        # resolves against every provider it can authenticate: with a Zen key
        # forwarded as well, `--provider opencode-go` alone was observed
        # answering from Zen instead. Naming another provider without a model
        # is the caller's to get right.
        [ -n "$chose_model" ] || set -- --model deepseek-v4.1-flash "$@"
        [ -n "$chose_provider" ] || needs_key=1
        [ -n "$chose_provider" ] || set -- --provider opencode-go "$@"
        ;;
esac

# Required only when this run reaches opencode-go: the default provider the
# case above supplies, the flag naming it, or a model under it. Another
# provider's missing key is Pi's to complain about, not this wrapper's, and
# --help, -h, --version and -v print and exit without a model call.
if [ -n "${needs_key:-}" ] && [ -z "${wants_info:-}" ] && [ -z "${OPENCODE_GO_API_KEY:-}" ]; then
    printf '%s\n' "OPENCODE_GO_API_KEY is required" >&2
    printf '%s\n' \
        "get it with: pi auth print-api-key --provider opencode-go" >&2
    exit 2
fi

# Look up the newest release of Pi so a newer one rebuilds the image even
# though the content tag has not changed. The host may lack python3 and jq, so
# sed pulls the version out of the JSON, and anything that is not a plain
# semver is unknown rather than trusted. `--max-time 5` bounds an offline or
# slow registry to a few seconds, and a missing curl fails the same way. An
# unknown version means the comparison cannot be made, so an existing image is
# kept, and a launch with no image stops.
lookup_version() {
    body=$(curl -fsS --max-time 5 "$1" 2>/dev/null) || return 0
    version=$(printf '%s' "$body" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    case "$version" in
        '' | *[!0-9A-Za-z.+-]*) return 0 ;;
        [0-9]*.[0-9]*) printf '%s' "$version" ;;
        *) return 0 ;;
    esac
}

want_version=$(lookup_version https://registry.npmjs.org/@earendil-works/pi-coding-agent/latest)

# One inspect both checks that the image exists and reads the version label.
# A failed inspect means the image is missing, and an image without the label
# reads as empty and rebuilds.
image_exists=0
if have_version=$(docker image inspect --format '{{index .Config.Labels "pi-sandbox.version"}}' "$image" 2>/dev/null); then
    image_exists=1
fi

# A build needs the version, since the Dockerfile carries no default.
if [ "$image_exists" -eq 0 ] && [ -z "$want_version" ]; then
    printf '%s\n' "pi-sandbox: could not look up the newest Pi, and there is no image to fall back to" >&2
    exit 1
fi

# The label is only compared when the lookup worked, since it says nothing
# otherwise. A missing label reads as empty and rebuilds.
build=0
if [ "$image_exists" -eq 0 ]; then
    build=1
elif [ -n "$want_version" ] && [ "$have_version" != "$want_version" ]; then
    build=1
fi

if [ "$build" -eq 1 ]; then
    # The lookup answered, since otherwise no build was requested above.
    if [ "$image_exists" -eq 1 ]; then
        printf '%s\n' "pi-sandbox: rebuilding $image: $have_version -> $want_version" >&2
    else
        printf '%s\n' "building $image" >&2
    fi
    build_status=0
    # shellcheck disable=SC2086  # empty off Linux
    docker build --file "$dockerfile" --tag "$image" $build_args \
        --build-arg "PI_VERSION=$want_version" \
        "$(dirname -- "$dockerfile")" || build_status=$?
    # A same-tag build that fails leaves the image the tag already held, so a
    # registry blip must not leave the user unable to start Pi. There is no
    # image to fall back to when this was a first build, so its status ends
    # the wrapper.
    if [ "$build_status" -ne 0 ]; then
        if [ "$image_exists" -eq 1 ]; then
            printf '%s\n' "pi-sandbox: could not update $image, starting the existing image" >&2
        else
            exit "$build_status"
        fi
    fi
fi

if [ "$image_exists" -eq 1 ] && [ -z "$want_version" ]; then
    printf '%s\n' "pi-sandbox: could not check the newest Pi, using the existing image" >&2
fi

# Half the daemon's CPUs, at least one, so a few spinning processes, far under
# the pids and memory limits, cannot hold every core. Docker refuses `--cpus`
# above its own count, so a fixed number would not start on a small machine.
cpus=$(docker info --format '{{.NCPU}}' 2>/dev/null) || cpus=1
cpus=$((cpus / 2))
[ "$cpus" -ge 1 ] || cpus=1

# The checks below are only good while no other container can write the
# project: one where `.git` is not protected can turn it into a symlink to a
# host directory a moment after they passed, and the mkdir and the mounts
# would follow it. So first remove the containers dead sessions left, and
# refuse while a session of this project, or of a directory above it, which
# mounts this one whole, still runs. Here, after the lookup, the build and
# every other daemon query, so the checks and `docker run` follow at once. docs/design.md has the details.
#
# The name is the tag of the physical path, so a symlink or another case
# cannot dodge the refusal, then where this wrapper runs and its pid. A pid
# means something only where it was read, so where it runs, the machine, the
# user and the pid namespace, is hashed into the name. Every removal by name
# then only reaches containers started from here: another user, a container
# or a second machine on the same daemon has its own. The machine is its id,
# Linux's machine-id or macOS's kern.uuid, since a Mac's host name changes
# from one network to the next and would strand a container left before the
# change. The host name stands in only where neither id exists.
origin=$(
    {
        cat /etc/machine-id 2>/dev/null || sysctl -n kern.uuid 2>/dev/null || uname -n
        id -u
        readlink /proc/self/ns/pid 2>/dev/null || true
    } | "$hash_cmd" | cut -c1-12
)
name=pi-sandbox-$(printf '%s' "$physical" | "$hash_cmd" | cut -c1-8)-$origin-$$
# A dead session can have left a container under this launch's pid, which
# would make `docker run --name` fail, and only this launch can hold it now.
docker rm -f "$name" >/dev/null 2>&1 || true
# Remove every container from here whose wrapper, the pid at the end of its
# name, no longer runs. A reused pid can only keep a dead session's container,
# never remove a live one. A `ps` that cannot see this wrapper either would
# call every session gone, so then nothing is removed and every container
# counts as live, as does one that would not go. A listing that failed could
# have hidden one.
if ! containers=$(docker ps -a --filter label=pi-sandbox=1 --format '{{.Names}}' 2>/dev/null); then
    printf '%s\n' "refusing to run: could not list the pi-sandbox containers, so another session of $project may still be running" >&2
    exit 2
fi
ps_works=''
if ps -p $$ >/dev/null 2>&1; then
    ps_works=1
fi
# The tags of this project and of every directory above it, as a session
# there would have named its container.
tags=' '
dir=$physical
while :; do
    tags="$tags$(printf '%s' "$dir" | "$hash_cmd" | cut -c1-8) "
    [ "$dir" != / ] || break
    dir=$(dirname -- "$dir")
done
for stale in $containers; do
    case "$stale" in
        pi-sandbox-*-"$origin"-*) ;;
        *) continue ;;
    esac
    case "${stale##*-}" in
        '' | *[!0-9]*) continue ;;
    esac
    if [ -n "$ps_works" ] && ! ps -p "${stale##*-}" >/dev/null 2>&1 \
        && docker rm -f "$stale" >/dev/null 2>&1; then
        continue
    fi
    tag=${stale#pi-sandbox-}
    case "$tags" in
        *" ${tag%%-*} "*)
            printf '%s\n' "refusing to run: a session of $project or a directory above it is still running in container $stale, and its agent could change the project while this launch checks it, so end that session first, or if none is open, remove the container with: docker rm -f $stale" >&2
            exit 2
            ;;
    esac
done

# A symlink at any of these is followed by Git, by the mkdir below and by the
# bind mounts, so the agent can point the host's Git at a config it wrote, or
# make this script create directories outside the project. The `.git` symlink
# was reproduced: the next launch mounted the target read-write and the agent
# read a host key from it. Refuse one rather than follow it, before every
# mount, and whether or not this is a repository.
for link in .git .git/config .git/hooks .git/modules .git/worktrees .git/config.worktree .git/commondir; do
    if [ -L "$project/$link" ]; then
        printf '%s\n' "refusing to run: $project/$link is a symlink, which Git and this script would follow outside the project, so inspect and remove it" >&2
        exit 2
    fi
done

# A read-only mount protects a path, not the file behind it. A hook or config
# that is a hard link or a symlink to a project file, or a symlinked directory
# such as a submodule's git directory, which the agent can make while `.git`
# is not protected, stays writable through the project in every later
# session (shown on Docker by e2e.py). So refuse any symlink under the
# read-only paths, and a second link to a file Git reads a command from: a
# local clone hard-links the objects, a submodule's too. The names are the
# agent's, so control bytes in them are replaced before they reach the
# terminal. find runs inside `.git`, so `*/hooks/*` never matches the
# project's own path.
for path in config config.worktree commondir hooks modules worktrees; do
    [ -e "$project/.git/$path" ] || continue
    if ! linked=$(cd "$project/.git" && find "./$path" \( -type l -o \
        \( -name config -o -name config.worktree -o -name commondir -o -path '*/hooks/*' \) \
        -type f -links +1 \) -print); then
        printf '%s\n' "refusing to run: could not check $project/.git/$path for links, so make it readable" >&2
        exit 2
    fi
    if [ -n "$linked" ]; then
        printf '%s\n' "refusing to run: these in $project/.git are a symlink or a hard link to another file, through which the agent could rewrite what your host git runs, so replace each with a copy:" >&2
        printf '%s\n' "$linked" | LC_ALL=C tr -c '[:print:]\n' '?' >&2
        exit 2
    fi
done

# `.git/config.worktree` and `.git/commondir` are created below when missing
# and then bind-mounted as files. `set -C` does not save that write from a
# FIFO, which dash opens and blocks on waiting for a reader, and Docker cannot
# mount a directory or a socket as a file either, so refuse anything there
# that is not an ordinary file. A symlink was caught above, and `[ -e ]`
# follows one, so a dangling link cannot slip past this.
for file in .git/config.worktree .git/commondir; do
    if [ -e "$project/$file" ] && [ ! -f "$project/$file" ]; then
        printf '%s\n' "refusing to run: $project/$file is not a regular file, which this script would create or mount as one, so inspect and remove it" >&2
        exit 2
    fi
done

# Git reads `commondir` in any git directory, not only a linked worktree's,
# and takes the config and hooks from the directory it names, so a
# `.git/commondir` the agent wrote makes the host's next `git status` run a
# command from a config it controls (reproduced 2026-09-23). A repository's
# own `.git` never has one, and the one this script creates holds `.`, so
# anything else was planted, possibly by a session from before this check.
# Git uses the whole file with trailing whitespace trimmed, and the shell
# cannot see a NUL byte, so `.\n\0` would compare as `.` here while Git
# followed `.git/.\n` (reproduced). Anything longer than the two bytes this
# script writes is therefore refused before the rest is compared, which also
# keeps a huge file out of this script.
if [ -f "$project/.git/commondir" ] && {
    [ "$(wc -c < "$project/.git/commondir")" -gt 2 ] \
        || [ "$(cat "$project/.git/commondir")" != . ]
}; then
    printf '%s\n' "refusing to run: $project/.git/commondir redirects Git to another directory's config and hooks, which your host git would run, so inspect and remove it" >&2
    exit 2
fi

# Allocate a TTY only when there is one, so the same wrapper serves a Herdr
# pane and a non-interactive check. Unquoted on purpose: these are two words.
tty_flags=--interactive
if [ -t 0 ] && [ -t 1 ]; then
    tty_flags="--interactive --tty"
fi

# Deliberately NOT `exec`: Herdr identifies a pane's agent from the foreground
# job's process arguments, and exec would replace this `pi`-named process with
# `docker`, leaving Herdr to see a plain shell.
# `trap : INT` lets Ctrl-C reach Pi inside the container instead of killing the
# wrapper out from under it. A handler (not '') is used so docker still gets
# SIGINT's default disposition.
trap : INT

# The tail of the docker command, the mounts and then the image and Pi's
# arguments, is built in the positional parameters. A variable holding the
# mounts would split on the spaces in a path like `/Users/x/my project`, and
# POSIX sh has no arrays. Prepend in reverse, because each `set --` puts its
# arguments first and the last mount must end up closest to the project.
set -- "$image" "$@"
# The label names the project, so the README's one-liner can remove the
# volumes of projects that are gone. Docker sets it only when it creates the
# volume.
set -- --mount "type=volume,source=$state_volume,target=/home/agent,volume-label=pi-sandbox.project=$project" "$@"
lock_git=''
if [ -d "$project/.git" ]; then
    # Remembered for the exit check: a root `.git` this launch protected is the
    # one the container could not have replaced, and is the only one to prune.
    protected_git=1
    # Mounting .git itself makes it a mount point, which cannot be renamed or
    # removed. Without it the agent can `mv .git .git-old`, build a fresh .git
    # with its own config and hooks, and the host runs what it names. The parts
    # that can name a command are then layered read-only over that writable
    # mount, so the index, objects and refs stay writable and `git add` and
    # `git commit` still work. A .git file (a linked worktree or a submodule
    # checkout) gets nothing: the real git directory is outside the mount and
    # git does not work in the container for it anyway.
    #
    # Created first on purpose. Without the directory the agent could make its
    # own and leave a hook in it for the host to run.
    mkdir -p "$project/.git/hooks"
    # A linked worktree keeps its git directory at .git/worktrees/<name>, and
    # files there redirect Git: `commondir` names the common directory a
    # worktree reads its config and hooks from, `gitdir` names the worktree
    # metadata, and `config.worktree` names a command through core.fsmonitor.
    # Any of them lets the agent point the host's Git at a config it wrote, so
    # the whole directory is read-only like the hooks. Created first for the
    # same reason, since a missing directory is not skipped. `git worktree add`
    # cannot work in the sandbox anyway: the paths in those files are host
    # paths.
    mkdir -p "$project/.git/worktrees"
    # Submodule configs carry the same hook and filter keys as .git/config,
    # and a git directory the agent builds at .git/modules/<name> is one the
    # host's Git reaches through the submodule's `.git` file and can run a
    # command from. Created first for the same reason as the hooks, so a
    # missing directory cannot be left for the agent to fill: the protected
    # `.git` is pruned at exit, so nothing there would be reported.
    mkdir -p "$project/.git/modules"
    # Created holding `.`, which names this directory as its own common
    # directory, so Git behaves exactly as without the file, and mounted
    # read-only so the agent cannot point it elsewhere. An empty file would
    # make Git refuse the repository. `set -C` keeps an existing one, which
    # was checked above.
    (set -C; printf '.\n' > "$project/.git/commondir") 2>/dev/null || true
    set -- --mount "type=bind,source=$project/.git/commondir,target=/workspace/.git/commondir,readonly" "$@"
    set -- --mount "type=bind,source=$project/.git/modules,target=/workspace/.git/modules,readonly" "$@"
    set -- --mount "type=bind,source=$project/.git/worktrees,target=/workspace/.git/worktrees,readonly" "$@"
    set -- --mount "type=bind,source=$project/.git/hooks,target=/workspace/.git/hooks,readonly" "$@"
    # `git sparse-checkout init --cone` sets extensions.worktreeConfig, and git
    # then reads .git/config.worktree, which can name a command through
    # core.fsmonitor just as .git/config can. It is writable through the .git
    # mount above unless it is covered too, so it gets the hooks' treatment
    # whether or not the extension is on. Git ignores an empty config.worktree
    # while it is off, so creating it changes nothing for the host. `set -C`
    # creates the file only when it is missing and refuses an existing one, so
    # a real config.worktree is not truncated. A non-regular file there was
    # refused above, before this write could block on a FIFO.
    (set -C; : > "$project/.git/config.worktree") 2>/dev/null || true
    set -- --mount "type=bind,source=$project/.git/config.worktree,target=/workspace/.git/config.worktree,readonly" "$@"
    set -- --mount "type=bind,source=$project/.git/config,target=/workspace/.git/config,readonly" "$@"
    set -- --mount "type=bind,source=$project/.git,target=/workspace/.git" "$@"
    # On a macOS disk, which ignores case, Docker Desktop resolved
    # `.git/CONFIG` to the host's `.git/config` past the read-only file
    # mounts, so the three files are also locked with the user-immutable flag
    # for the session. docs/design.md has the details. The container carries
    # the identity of `.git`, which no other path to the same repository
    # changes, and which, unlike the config file, Git never replaces.
    if [ "$(uname -s)" = Darwin ]; then
        lock_git=1
        git_id=$(stat -f %d-%i "$project/.git")
        set -- --label "pi-sandbox.git=$git_id" "$@"
    fi
fi

flag_git_files() {
    [ -n "$lock_git" ] || return 0
    chflags "$1" "$project/.git/config" "$project/.git/config.worktree" "$project/.git/commondir"
}
# Only once no container using these files is left, so a session ending while
# another one runs does not unlock the files under it.
release_git_files() {
    [ -n "$lock_git" ] || return 0
    # A failed listing cannot rule one out, so the files stay locked.
    left=$(docker ps -aq --filter "label=pi-sandbox.git=$git_id" 2>/dev/null) || return 0
    [ -n "$left" ] || flag_git_files nouchg
}

# A nested repository cannot be stopped by a mount: the agent can `git init
# sub`, the host user owns what it writes, and host git trusts the config and
# hooks there. Warn about it at exit instead. ctime is compared because
# `touch` cannot forge it.
marker=$(mktemp)

# `--rm` removes the container only once it stops, and it does not stop when
# this wrapper or the docker client dies under it: a SIGHUP, SIGTERM or SIGKILL
# to the wrapper, or a killed client, left it running with nobody attached
# (measured with e2e.py). So the container gets a name of its own, and a
# watcher removes it once this wrapper is gone. The watcher ignores the
# signals that end the wrapper, a closed pane's hangup among them. It removes
# the container twice, because a client orphaned in its first second can
# still be creating it, and the next launch's sweep catches one that takes
# longer. It is in the wrapper's process group, so a SIGKILL to the whole
# group, which cannot be trapped, takes it too and leaves the container
# running until the next launch, which removes it before its checks.
(
    trap '' HUP INT TERM
    while kill -0 $$ 2>/dev/null; do
        # A session that ends while this one starts sees no container of the
        # project yet and releases the files, so they are locked again here.
        flag_git_files uchg || true
        sleep 1
    done
    docker rm -f "$name" || true
    sleep 5
    docker rm -f "$name" || true
    release_git_files
) </dev/null >/dev/null 2>&1 &
watcher=$!

if ! flag_git_files uchg; then
    rm -f "$marker"
    printf '%s\n' "refusing to run: could not lock $project/.git/config, config.worktree and commondir with chflags, which is what keeps the agent from rewriting them on a case-insensitive disk" >&2
    exit 2
fi

docker_status=0
# shellcheck disable=SC2086
docker run \
    --rm \
    --init \
    --name "$name" \
    $tty_flags \
    --label pi-sandbox=1 \
    --hostname pi-sandbox \
    --workdir /workspace \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit 512 \
    --memory 8g \
    --cpus "$cpus" \
    --log-driver none \
    --env OPENCODE_GO_API_KEY \
    --env OPENCODE_API_KEY \
    $extra_env \
    --env TERM=xterm-256color \
    --env COLORTERM=truecolor \
    --mount "type=bind,source=$project,target=/workspace" \
    "$@" || docker_status=$?

# A killed client returns here while the container runs on, still able to
# write the project, so remove it before the checks below look at it.
docker rm -f "$name" >/dev/null 2>&1 || true
# The wrapper got here, so the watcher has nothing left to do, and it would
# lock the files again. It ignores TERM. Reaping it keeps bash, which is macOS
# /bin/sh, from printing `Killed: 9` and the watcher's source on every exit. A
# status of 128 or more may be a killed client, which can still be creating
# the container, so the watcher, whose second removal catches that, releases
# the files then instead.
if [ "$docker_status" -lt 128 ]; then
    kill -KILL "$watcher" 2>/dev/null || true
    wait "$watcher" 2>/dev/null || true
    release_git_files || true
fi
if [ "$docker_status" -lt 128 ]; then
    kill -KILL "$watcher" 2>/dev/null || true
    wait "$watcher" 2>/dev/null || true
    release_git_files || true
fi

# Prune the project's own .git, but only when this launch protected it with a
# mount, and look for nested git metadata the container created. Warn only,
# never delete.
#
# In a project that was not a repository at launch nothing was mounted over
# `.git`, so the container can create a root `.git`, file or directory, whose
# config, hooks or `core.worktree` the host would then trust. Pruning the root
# unconditionally hid it. An empty pattern matches nothing, so find descends
# into it and reports it like a nested one.
#
# `-path` takes a glob, so a `[`, `*` or `?` in the project path would stop the
# prune from matching the root `.git`: with `[x]` the protected root is
# reported as nested, and with `*` a real nested one is pruned away and missed.
# Escape those characters before building the pattern.
git_path=$(printf '%s' "$project" | sed 's/[][*?\\]/\\&/g')
git_prune=''
if [ -n "${protected_git:-}" ]; then
    git_prune=$git_path/.git
fi
# Host git also takes a directory holding a HEAD, objects and refs for a bare
# repository, with no `.git` in its name, so a new HEAD file is reported too,
# by the directory it is in. Git only takes a file or a symlink for HEAD.
# macOS file systems ignore case by default, and host git there opens `.GIT`
# and `head` as well, so the names match in any case. The prune stays exact,
# since on a case-sensitive file system `.GIT` is not the protected root.
#
# `-H` follows the project path itself when it is a symlink, which find
# otherwise does not enter. The agent chose the names, and an escape sequence
# or a newline in one could erase the warning or add a line to it, so the part
# of each under the project is printed with every byte that is not printable
# ASCII as a `?`. A directory the agent made unreadable makes find fail, but
# what it found elsewhere is still reported, with a note that the check is
# incomplete. A directory without its search bit fails it too, through
# `-exec false`, since macOS find skips what is inside one without an error,
# and Docker Desktop turns the agent's mode 000 into 0600 on the host.
find_failed=''
# `$1` and `$p` belong to the `sh -c` script, so it stays single-quoted.
# shellcheck disable=SC2016
found=$(LC_ALL=C find -H "$project" -path "$git_prune" -prune -o \
    -type d ! -perm -0100 -prune -exec false {} + -o \
    \( -iname .git -o \( -iname HEAD ! -type d \) \
    -o -ipath '*/.git/config' -o -ipath '*/.git/config.worktree' \
    -o -ipath '*/.git/commondir' -o -ipath '*/.git/hooks/*' \) \
    -cnewer "$marker" \
    -exec sh -c 'root=$1; shift; for p do printf "%s\000" "${p#"$root"}"; done |
        tr -c "[:print:]\000" "?" | tr "\000" "\n"' sh "$project" {} + \
    2>/dev/null) || find_failed=1
# Each name is now the part under the project, which is the user's own path
# and is added back as it is when printed. A `git init sub` writes sub/.git,
# its config and a hooks/*.sample for every hook, so one repository printed
# fifteen lines. Keep the `.git` path once and drop what is under it. A HEAD
# at the root collapses to an empty line, which prints as the project path, so
# the warning below tests `$found`, not `$nested`.
nested=$(printf '%s\n' "$found" \
    | LC_ALL=C sed -e 's#\(.*/\.[Gg][Ii][Tt]\)/.*#\1#' -e 's#/[Hh][Ee][Aa][Dd]$##' \
    | LC_ALL=C sort -u)
# A rebase, merge or cherry-pick the container planted makes the host's Git
# report an operation in progress, and `git rebase --continue` then runs the
# `exec` lines the todo holds. The paths cannot be blocked, since an empty
# rebase-merge directory would itself make Git think a rebase is in progress,
# so warn instead. ctime again, and the whole directory is checked so a file
# the agent edited inside one already there counts too.
interrupted=''
for state in rebase-merge rebase-apply sequencer MERGE_HEAD CHERRY_PICK_HEAD; do
    candidate=$project/.git/$state
    if [ -e "$candidate" ] && [ -n "$(find "$candidate" -cnewer "$marker" -print 2>/dev/null)" ]; then
        interrupted=$(printf '%s%s\n' "$interrupted" "$candidate")
    fi
done
rm -f "$marker"
# The agent can leave the terminal drawing black on black, concealed, in the
# alternate screen or with the default colours swapped, and kill Pi so that
# nothing undoes it. DECSTR and SGR 0 reset how text is drawn, the private
# modes leave the alternate screen and synchronized output and turn wrapping
# back on, and OSC 104, 110 and 111 restore the palette and the default
# colours. Only before a warning, since they also undo colours the user set on
# purpose.
if [ -t 2 ] && [ -n "$found$find_failed$interrupted" ]; then
    printf '\033[!p\033[m\033[?1047l\033[?2026l\033[?7h\033]104\007\033]110\007\033]111\007' >&2
fi
if [ -n "$found" ]; then
    printf '%s\n' "pi-sandbox: warning: the container left nested git metadata in the project:" >&2
    printf '%s\n' "$nested" | while IFS= read -r line; do
        printf '%s%s\n' "$project" "$line"
    done >&2
    printf '%s\n' "your host git trusts it and would run the commands it names, so inspect it before running git there" >&2
fi
if [ -n "$find_failed" ]; then
    printf '%s\n' "pi-sandbox: warning: the nested-git check could not run in full because find failed or could not read part of the project, so it may hold nested git metadata not listed here" >&2
fi
if [ -n "$interrupted" ]; then
    printf '%s\n' "pi-sandbox: warning: the container left a git operation in progress:" >&2
    printf '%s\n' "$interrupted" >&2
    printf '%s\n' "your host git will report a rebase, merge or cherry-pick, and continuing it can run commands stored in those files, so inspect and abort it rather than continue" >&2
fi

# Remove the images earlier builds left behind, now that the session is over.
# `docker rmi` fails when another running session uses an image, which is
# expected, so its output is discarded and the loop carries on. The prune then
# removes the dangling image a same-tag rebuild left. None of this may reach
# the user's terminal except one summary line, and none of it may change the
# exit status below.
removed=''
if tags=$(docker images pi-sandbox --format '{{.Tag}}' 2>/dev/null); then
    for tag in $tags; do
        if [ "$tag" = "${image#pi-sandbox:}" ] || [ "$tag" = "<none>" ]; then
            continue
        fi
        if docker rmi "pi-sandbox:$tag" >/dev/null 2>&1; then
            removed="$removed $tag"
        fi
    done
fi
docker image prune -f --filter label=pi-sandbox.image=1 >/dev/null 2>&1 || true
# Each rebuild for a new Pi also leaves the build cache of the layer it
# replaced, Pi's npm install, which no image uses once the old one is gone.
# Docker only collects that at its own limit, about 190 MB per Pi release
# until then. Prune just those records, picked by the text of their own
# Dockerfile step, so another project's cache is never touched. Dockerfile.pi
# keeps that step last, since a record that later layers build on cannot be
# pruned on its own. Only after a rebuild or a removal, since nothing else
# leaves one and the listing sizes every volume on the host. Docker prints
# `.Shared` and `.InUse` as the strings true and false, which `not` reads as
# set either way. The id is checked because docker matches it as a pattern,
# and a stray word from a multi-line description would match others.
if [ "$build" -eq 1 ] || [ -n "$removed" ]; then
    docker system df -v --format '{{range .BuildCache}}{{if eq .Shared "false"}}{{if eq .InUse "false"}}{{println .ID .Description}}{{end}}{{end}}{{end}}' 2>/dev/null \
        | grep -F 'the wrapper must pass --build-arg PI_VERSION' \
        | while read -r cache_id _; do
            case "$cache_id" in
                '' | *[!a-z0-9]*) continue ;;
            esac
            # BuildKit's ids are 25 characters, and a short word would match
            # many as a pattern.
            if [ "${#cache_id}" -lt 20 ]; then
                continue
            fi
            docker builder prune -f --filter "id=$cache_id" >/dev/null 2>&1 || true
        done
fi
if [ -n "$removed" ]; then
    printf '%s\n' "pi-sandbox: removed old images:$removed" >&2
fi

# Docker's status is the wrapper's. `set -e` must not skip the check above.
exit "$docker_status"
}
